# ========================================================
# Park PSU - Environment Configuration Template (.env.example)
# ========================================================

# Server Port (default: 8080)
PORT=8080

# Database Connection (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/park_psu
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Show SQL queries in logs (true/false)
SHOW_SQL=false

# JWT Secret Key (Base64-encoded, minimum 256 bits / 32 bytes)
JWT_SECRET=itkICswj9AWlYWLK6GEmcEsFDVkRemVHcAliKSEAXgw=

# CORS Allowed Origins (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Enable/Disable Background Tasks Scheduler (web=false, worker=true)
SCHEDULING_ENABLED=true
