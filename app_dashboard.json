          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "title": "USE: Паузы Garbage Collection (GC Duration & Rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Время остановок приложения сборщиком мусора (GC Pause time) и частота циклов сборки",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GC Pause Time (ms/sec)"
            },
            "properties": [
